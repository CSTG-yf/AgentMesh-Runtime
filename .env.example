# Optional LLM provider settings for future/extended agent implementations.
# The current MVP remains deterministic and does not require network access.

AGENTMESH_LLM_BASE_URL=
AGENTMESH_LLM_API_KEY=
AGENTMESH_LLM_MODEL=
AGENTMESH_LLM_TIMEOUT_SECONDS=30
AGENTMESH_PROMPT_DIR=

# Optional embedding provider. Text Mode never uses embeddings; Protocol Mode
# can use TEI and falls back to HashEmbedding if the service is unavailable.
AGENTMESH_EMBEDDING_PROVIDER=hash
AGENTMESH_EMBEDDING_BASE_URL=http://127.0.0.1:8080
AGENTMESH_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AGENTMESH_EMBEDDING_DIMENSIONS=512
AGENTMESH_EMBEDDING_TIMEOUT_SECONDS=15
